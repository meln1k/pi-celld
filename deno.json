{
  "nodeModulesDir": "auto",
  "imports": {
    "@earendil-works/chord": "npm:@earendil-works/chord@1.1.0",
    "@earendil-works/pi-ai": "npm:@earendil-works/pi-ai@1.1.0",
    "@earendil-works/pi-durable": "npm:@earendil-works/pi-durable@1.1.0",
    "diff": "npm:diff@8.0.4",
    "typebox": "npm:typebox@1.3.27",
    "@cloudflare/workers-types": "npm:@cloudflare/workers-types@5.20261005.1",
    "just-bash": "npm:just-bash@3.6.0",
    "remix": "npm:remix@3.0.0",
    "esbuild": "npm:esbuild@0.28.2",
    "wrangler": "npm:wrangler@4.148.0",
    "@types/node": "npm:@types/node@26.6.4",
    "cloudflare:workers": "./app/cells/test-runtime.ts",
    "./dist/worker": "./worker.ts"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"],
    "types": ["@types/node", "./worker-configuration.d.ts"],
    "skipLibCheck": true,
    "noImplicitOverride": false,
    "jsx": "react-jsx",
    "jsxImportSource": "remix/component"
  },
  "tasks": {
    "build": "rm -rf dist && mkdir -p dist && cp -r public dist/public && deno run -A --frozen build.ts",
    "celld": "deno task build && celld dev --no-watch",
    "test": "NODE_ENV=test deno test -A --frozen app/",
    "test:celld": "deno test -A --frozen celld-smoke.ts",
    "generate-types": "deno task build && deno run -A npm:wrangler@4.148.0 types --include-runtime=false --strict-vars=false",
    "typecheck": "deno task generate-types && deno check --frozen build.ts worker.ts celld-smoke.ts app/"
  },
  "exclude": ["dist", "node_modules", ".amp", ".celld"]
}
