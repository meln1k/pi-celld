{
  "name": "pi-celld",
  "main": "dist/worker.js",
  "no_bundle": true,
  "compatibility_date": "2026-10-05",
  "vars": { "AGENT_MODEL": "deepseek-v4.1-flash" },
  "durable_objects": {
    "bindings": [
      { "name": "AGENT_SESSIONS", "class_name": "AgentSession" },
      { "name": "USERS", "class_name": "User" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AgentSession"] },
    { "tag": "v2", "new_sqlite_classes": ["User"] },
  ],
  "assets": {
    "directory": "dist/public",
    "html_handling": "none",
    "not_found_handling": "none",
  },
}
